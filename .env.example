# ──────────────────────────────────────────────
# Web Fabrikası — Ortam Değişkenleri
# Bu dosyayı kopyala: cp .env.example .env
# .env dosyasını asla Git'e commit etme!
# ──────────────────────────────────────────────

# ── GENEL ─────────────────────────────────────
BASE_DEMO_URL=https://KULLANICI_ADIN.github.io/REPO_ADI/demos
PURCHASE_URL=https://satin-al.webfabrika.com.tr

# ── TWILIO (WhatsApp Gönderimi) ───────────────
# twilio.com → Console → Account Info
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── GOOGLE PLACES API ─────────────────────────
# console.cloud.google.com → Places API etkinleştir
GOOGLE_PLACES_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── IYZICO (Ödeme) ────────────────────────────
# iyzico.com → Ayarlar → API Anahtarları
IYZICO_API_KEY=sandbox-xxxxxxxxxxxxxxxxxxxxxxxx
IYZICO_SECRET_KEY=sandbox-xxxxxxxxxxxxxxxxxxxxxxxx
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ── WEBHOOK SUNUCU ────────────────────────────
WEBHOOK_PORT=8080
WEBHOOK_SECRET=gizli_bir_token_buraya

# ── BİLDİRİM ──────────────────────────────────
# Slack webhook — satış olunca bildirim al
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ── GÜNLÜK LİMİTLER ──────────────────────────
DAILY_WHATSAPP_LIMIT=50
WAIT_BETWEEN_MESSAGES_MIN=35
WAIT_BETWEEN_MESSAGES_MAX=90
